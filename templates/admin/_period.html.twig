<form method="get" class="periods">
    {% if extra is defined %}{{ extra|raw }}{% endif %}
    <label>{{ 'report.from'|trans({}, 'ledger') }}<input class="form-control" type="date" name="from" value="{{ from|date('Y-m-d') }}"></label>
    <label>{{ 'report.to'|trans({}, 'ledger') }}<input class="form-control" type="date" name="to" value="{{ to|date('Y-m-d') }}"></label>
    {% if compare is defined %}<label class="check"><input type="hidden" name="n1" value="0"><input type="checkbox" name="n1" value="1"{{ compare ? ' checked' }}> {{ 'report.compare'|trans({}, 'ledger') }}</label>{% endif %}
    <button class="btn btn-sm btn-secondary" type="submit">{{ 'report.show'|trans({}, 'ledger') }}</button>
</form>
