{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'report.balance_sheet'|trans({}, 'ledger') }} · {{ book.name }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-building-columns"></i></span>
    <div class="admin-header-titles">
        <h1>{{ 'report.balance_sheet'|trans({}, 'ledger') }} · {{ book.name }}</h1>
        <div class="admin-header-subtitle">
            {{ 'report.at_date'|trans({date: at|date('d/m/Y')}, 'ledger') }}
            {% if compare %} · {{ 'report.previous_at'|trans({date: previous_at|date('d/m/Y')}, 'ledger') }}{% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
{{ include('@Ledger/admin/_style.html.twig') }}
<div class="ledger">
    {{ include('@Ledger/admin/_report_nav.html.twig', {current: 'ledger_admin_balance_sheet'}) }}
    <form method="get" class="periods">
        <label>{{ 'report.at'|trans({}, 'ledger') }}<input class="form-control" type="date" name="at" value="{{ at|date('Y-m-d') }}"></label>
        <label class="check"><input type="hidden" name="n1" value="0"><input type="checkbox" name="n1" value="1"{{ compare ? ' checked' }}> {{ 'report.compare'|trans({}, 'ledger') }}</label>
        <button class="btn btn-sm btn-secondary" type="submit">{{ 'report.show'|trans({}, 'ledger') }}</button>
    </form>
    <div class="toolbar no-print">
        <button type="button" class="btn btn-sm btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> {{ 'report.print'|trans({}, 'ledger') }}</button>
        <a class="btn btn-sm btn-secondary" href="{{ path('ledger_admin_balance_sheet', {book: book.id, at: at|date('Y-m-d'), n1: compare ? 1 : 0, format: 'csv'}) }}"><i class="fa-solid fa-file-csv"></i> CSV</a>
        {% if not report.balanced %}<span class="pill unmatched">{{ 'report.bs_unbalanced'|trans({}, 'ledger') }}</span>{% endif %}
    </div>
    <div class="statements">
        <div class="card">
            {{ include('@Ledger/admin/_statement.html.twig', {title: 'report.assets'|trans({}, 'ledger'), groups: report.assets, total_label: 'report.total_assets'|trans({}, 'ledger'), total: report.totals.assets, previous_total: report.previous.assets ?? null, link: null}) }}
        </div>
        <div class="card">
            {{ include('@Ledger/admin/_statement.html.twig', {title: 'report.liabilities'|trans({}, 'ledger'), groups: report.liabilities, total_label: 'report.total_liabilities'|trans({}, 'ledger'), total: report.totals.liabilities, previous_total: report.previous.liabilities ?? null, link: null}) }}
        </div>
    </div>
</div>
{% endblock %}
